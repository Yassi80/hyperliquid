[Unit]
Description=hlflows: daily database backup to GCS
After=network-online.target

[Service]
Type=oneshot
User=hlflows
Group=hlflows
EnvironmentFile=/etc/hlflows/deploy.env
Environment=HLFLOWS_CONFIG=/etc/hlflows/hlflows.toml
Environment=CLOUDSDK_CONFIG=/var/lib/hlflows/.gcloud
ExecStart=/opt/hlflows-runtime/backup.sh
Nice=10
# A healthy backup takes minutes; never let a stuck one hold the disk for hours.
TimeoutStartSec=1h

[Unit]
Description=hlflows: rebuild the dashboard (served by Caddy), then check alerts
After=network-online.target

[Service]
Type=oneshot
User=hlflows
Group=hlflows
Environment=HLFLOWS_CONFIG=/etc/hlflows/hlflows.toml
# "-": a failed build doesn't stop the alert check, which then reports stale data.
ExecStart=-/opt/hlflows-runtime/venv/bin/hlflows dashboard --out /var/lib/hlflows-www/index.html --json /var/lib/hlflows/flows.json
ExecStart=/opt/hlflows-runtime/venv/bin/hlflows alerts
# Lower priority than the recorder; capped so a slow build can't crowd it out.
Nice=15
CPUWeight=20
MemoryMax=500M
TimeoutStartSec=300

# Copy to deploy/gcp/gcp.env and fill in. Used by push.sh and pull-data.sh (on your Mac).
PROJECT=your-gcp-project-id
REGION=us-central1            # free-tier e2-micro regions: us-central1, us-east1, us-west1
ZONE=us-central1-a
VM=hlflows
BUCKET=your-unique-bucket-name  # globally unique; same region as the VM
